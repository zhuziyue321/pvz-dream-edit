extends RefCounted
class_name ModIds
## 模组 id 常量表
##
## 本体与模组一律引用这里的常量，不写字面量字符串（写歪了不会报错，只会静默装不上）。
## 硬约束 §1-4：id → 脚本的映射只准出现在注册表里，这里的 id 与
## `ModManager.MOD_SCRIPT_PATHS` 一一对应。
##
## 新增一个模组的三步：
##   1. 本文件加一个常量
##   2. `ModManager.MOD_SCRIPT_PATHS` 加一行（id → 入口脚本路径）
##   3. `mods_builtin/<id>/` 下写入口脚本（`extends "res://src/mods/mod_base.gd"`）与该模组自己的脚本 / 场景
## 开关：模组页面里开 / 关，存进 `user://<用户名>/mod_config.ini`（`ModManager` 统一管）；
## `data/mods/mod_config.tres` 只是**没有存档文件时播种用的工程默认**。

## 手套：把场上已种下的植物搬到另一个格子（不铲除、不重种，实例与状态全保留）
## 原版没有这个玩法（原版手套是禅境花园工具），所以整条链路都在模组里
const GLOVE := &"glove"

## 自制关卡：把 `user://custom_level` 下的玩家自制关卡脚本加载成可选关卡，
## 并在主菜单加一个入口按钮。原版没有这个功能，所以整条链路都在模组里
const CUSTOM_LEVEL := &"custom_level"

## 玩家对战：主菜单木牌上的「MULTIPLAYER」牌 → 玩家对战选关界面。
## 原版没有对战玩法，所以整条链路都在模组里；**当前是「玩家对战：白天」的卡槽部分**：
## 左上六格植物卡槽（本体流程）+ 右上六格反转僵尸卡槽（由 [ModIds.ZOMBIE_CARD] 装，
## 本模组声明了对它的依赖），对战逻辑（胜负 / 收入 / 放置限制）还没做
const PLAYER_BATTLE := &"player_battle"

## 联机：多人（先做两人）合作共守一块草坪。原版没有任何联机功能，所以整条链路都在模组里。
## 当前是**骨架**：ENet 连线 + 玩家操作命令上行，还没做状态同步（见
## [联机模组](../../docs/参考存档/联机模组.md) §5 的阶段划分）
const NETPLAY := &"netplay"

## 更多的防具：铁桶之外再加三种矿石桶（铜桶 / 钻石桶 / 下界合金桶），
## 各配一只戴桶的僵尸。原版的桶只有铁桶一种，所以这三个盔甲连同它们的僵尸都在本模组里
const MORE_ARMOR := &"more_armor"

## 锤子：点一下草坪，对小范围内的僵尸造成伤害（伤害数值可调，也可一键秒杀）。
## 原版没有这个玩法（原版锤子只属于「锤僵尸」迷你游戏），所以整条链路都在模组里。
## 与迷你游戏的锤子（`src/items/mini_game/`、手持物类型 `Hammer`）互不相干
const HAMMER := &"hammer"

## 紫卡直接种植：紫卡（升级植物）不必先种基座植物，可以直接种在空地上，
## 代价是那一格多付「基座植物的阳光 + 50」。原版紫卡只能种在基座上，所以做成模组
const PURPLE_DIRECT_PLANT := &"purple_direct_plant"

## 生态版：只**调整原版已有的数值**（阳光 / 伤害 / 连发 / 索敌 / 光照等 10 条），
## 不加任何玩法。原版数值是多少就该是多少，所以这类同人调整做成模组 —— 关掉 = 回到原版数值
const ECO := &"eco"

## PVZ2：把《植物大战僵尸 2》的角色搬进本作（菜问 / 潜伏芹菜 / 火焰豌豆射手 / 豌豆荚 / 毒液豌豆）。
## 原版没有这些角色，美术也不是原版那套格式（PVZ2 是 PAM / XFL，不是 `.reanim`）——
## 所以整件东西做成模组：PAM 离线烘成「一张图集 + 一个 `.pam.bin`」，运行时由
## **模组「PAM 动画播放器」**（[ModIds.PAM]）按帧画，本仓库不在运行时解析 PAM。
## 植物 id 自己起（`&"pvz2_bonkchoy"`），本体不必再留 `PlantIds` 空槽位
const PVZ2 := &"pvz2"

## PAM 动画播放器：PVZ2 那套 PopAnim（`.pam.bin`）的**运行时播放器**，本身不加玩法。
## 单独拆成一个模组是因为 PVZ2 的植物 / 子弹 / 僵尸 / 特效都要播 PAM，别的模组以后也会用
## 同一套 —— 播放口径（状态机 / 循环 / 单次 / 部件显隐 / 包围盒）只在这里维护一次。
## 「PVZ2」通过 `get_mod_dependencies()` 依赖它，打开 PVZ2 会自动带上
const PAM := &"pam"

## 招笑版：改**向日葵**、**豌豆射手**与**樱桃炸弹**三只植物，三套都是原版没有的演出 —— 关掉 = 回到原版。
## 向日葵 → 「朝阳葵」：任何一株产阳光时其余朝阳葵一起转头看它（目标在左边就把花头镜像过去，
## 再旋转到「右侧对准目标」），它自己冒一颗汗（借禅境花园那颗「缺水」水珠贴图）。
## 豌豆射手 → 「傻豆射手」：普通攻击打出去的是一颗**不伤害人**的傻豆（两种随机：飞到僵尸跟前
## 掉地上 / 射偏），每打一颗攒怒气、怒气把整株染红，满了放大招 —— 怒气匀速降下去，
## 这段时间朝正前方 ±一定角度散射一堆**普通豌豆**
## 樱桃炸弹 → 「烟熏樱桃」：爆炸**一点伤害都不造成**，改成给范围内的僵尸上 30 秒**烟熏** ——
## 被烟熏的僵尸遇到植物就**站着播待机**（不啃、植物一滴血不掉），并且**被同类索敌**
## （标上本体那个「谁都能打它」的口子，归属阵营不变 ⇒ 玩家的植物照旧打得中它）
## 另加**摔倒机制**（僵尸像被绊倒一样趴地上、过一会儿自己站起来继续走）与一只
## 「绊倒路障僵尸」（路障僵尸变种：10 倍速、无视植物、走到第 4 列摔倒，路障永久留在草坪上绊倒后来的僵尸）
const ZHAOXIAO := &"zhaoxiao"

## 明日方舟：把《明日方舟》的战斗数值规则搬进本作（那些概念原版都没有）：
## 防御力 / 法术抗性 + 物理 / 法术伤害分类（未标记的伤害按物理算）+ 植物精英化
## （每种内置植物一个精英副本，普通关代替原版、特殊关用原版）。
## 默认数值全为 0，开着也是原版体验；数值填 `arknights/arknights_stats.gd` / `arknights/arknights_elite.gd`。
## 角色（干员 / 新僵尸）日后再按 [模组机制](../../docs/参考存档/模组机制.md) §四 往里装
const ARKNIGHTS := &"arknights"

## 调试模式：原版没有的调试功能 —— 僵尸卡片（含僵王）、四株隐藏植物（三种保龄球 + 反向双发）、
## `EventBus` 事件追踪、Ctrl+Q 调试窗口。原版一个都没有，所以整条链路都在模组里；
## 关掉 = 主场景里不会多出窗口、僵尸页与那四株的解锁一并撤掉
const DEBUG := &"debug"

## DLC 植物：把某份《植物大战僵尸》DLC 里的植物动画搬进本作（投掷蘑菇 / 光照蘑菇 / 臼炮蘑菇 / 血橙 /
## 闪电芦苇 / 飓衣甘蓝 / 电击蘑菇 / 幽灵椒 / 火蘑菇 / 泡椒 / 电豌豆 / 蜜蜂射手 / 甜菜守卫 / 拳击白菜 /
## 芦荟 / 橡木弓箭手 / 缩小紫罗兰 / 柠檬榴弹 / 增幅鹅河菊 / 巨噬花 / 等离子木 / 冰豌豆 / 藤蔓胡桃 /
## 荆棘苔藓 / 无畏蘑菇 / 环轨仙人球 / 流星杨桃 / 火豌豆 / 等离子豌豆 / 辣椒投手 / 冰椒 / 冰胡桃 等）。
## 原版没有这些角色，所以整件东西做成模组；动画由 R2Ga_PVZ 面板从 `mods_builtin/dlc/reanim/` 下的
## `.reanim`（已从 PopCap 的 `.compiled` 壳剥出）转换而来，关掉模组 = 回到原版。
const DLC := &"dlc"

## 僵尸卡：发僵尸卡牌，并换上 PVZ2 的僵尸卡槽 / 僵尸卡面 / 脑光。
## 原版 PVZ1 的常规关卡没有「在关卡里直接放下僵尸」，但本体留了这条通道（僵尸种子包
## `SEED_ZOMBIE_*`，解谜模式「僵尸公敌」靠它发牌）—— 只是默认关着
## （`ConstFeatureSwitch.ZOMBIE_CARD_ENABLED = false`，开了普通关卡的选卡界面也会冒出僵尸页）。
## 本模组**不去动**那个全局总开关，只在需要僵尸卡的两类关卡里直接发牌：
## 「我是僵尸」（`game_para.is_zombie_mode`）与「玩家对战」（`ChooseLevelPlayerBattle`，
## 那里右上装一条反转的六格僵尸卡槽，见玩家对战模组）
const ZOMBIE_CARD := &"zombie_card"
