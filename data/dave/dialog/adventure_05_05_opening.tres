[ext_resource type="Script" path="res://data/dave/crazy_dave_dialog_resource.gd" id="13_dave"]

[resource]
; 原版冒险模式 5-5 开场戴夫台词
; 台词文本: data/strings/lawn_strings.txt 的 CRAZY_DAVE_1301~1311
; 数据来源: PVZ Wiki(https://plantsvszombies.wiki.gg/wiki/Plants_vs._Zombies/Dialogue) 的 Level 5-5 段
; 原版口径: 前 3 句(1301~1303,禅境花园收尾)只在第一轮说,后 8 句(1304~1311,警告飞贼僵尸)每轮都说;
; 本仓库的 dave_dialog_only_first_playthrough 是整段级开关,这里按"每轮都播"处理(见 docs/参考存档/特殊关卡.md)
script = ExtResource("13_dave")
dialog_detail_list = Array[ExtResource("1_detail")]([ExtResource("2_op0"), ExtResource("3_op1"), ExtResource("4_op2"), ExtResource("5_op3"), ExtResource("6_op4"), ExtResource("7_op5"), ExtResource("8_op6"), ExtResource("9_op7"), ExtResource("10_op8"), ExtResource("11_op9"), ExtResource("12_op10")])
