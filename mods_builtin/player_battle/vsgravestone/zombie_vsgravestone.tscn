; 出土裁剪板：**裁剪模式必须 2；底必须「照常提交绘制、但看不见」**。三条都是 2026-10-25
; 探针实测（黑底格子逐像素统计，见 docs/工作记录/2026-10-25_产脑光墓碑.md）：
;   · `clip_children` 用 1（ONLY）→ 裁的是「**直接子节点**」，而本株直接子节点是动画挂点
;     （自己一个像素都不画）→ 裁剪区域为空 → **整棵动画连同板都不渲染**（墓碑直接消失）；
;   · 底不画（`StyleBoxEmpty` / 全透明）→ 没有裁剪区 → 石碑出土时整截从地下露出来；
;   · 底调成低 alpha（1/255、0.02）→ 绘制命令被引擎按透明度剔除 → 同样没有裁剪区 →
;     连石碑一起被裁没。
; 正解：底用普通 `StyleBoxFlat`（命令照常提交、矩形被记下 → 裁剪区成立），再挂一个输出
; 全透明的 shader（剔除发生在光栅化，不影响裁剪区）—— 裁剪照常，板肉眼完全看不见。
[sub_resource type="ShaderMaterial" id="ShaderMaterial_mask"]
shader = ExtResource("9_maskshader")

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_mask"]

[node name="PlayerBattleVsGravestone" instance=ExtResource("1_base")]
script = ExtResource("2_script")
zombie_type = &"zombie_card_vsgravestone"

[node name="HpComponent" parent="." index="4"]
max_hp = 300

; 血量阶段变化组件：本株的受损外观由脚本自己播 `break1~5`，**不走**它
; （见 `vsgravestone_zombie.gd` 文件头）。但它必须有一份**对齐的非空表**：
; 留空的话 `component_ready()` 会按僵尸默认补两档（2/3、1/3 血），而 `body_change`
; 仍是空数组 → 掉到 1/3 血时 `body_change[i]` 越界抛错，把 `signal_hp_loss` 后面的
; 接收者（脚本里的 `_on_hp_loss`）一起打断（2026-10-25 探针抓到的）。
; 这里只留死亡线 0 + 一个 null 档：每个阶段都 `continue`，外观全交给脚本。
[node name="HpStageChangeComponent" parent="." index="3"]
boundary_value_hp = Array[int]([0])
body_change = Array[ExtResource("15_bodychange")]([null])

; 动画不进 AnimationTree：换空组件，由脚本直接播 AnimLib
[node name="AnimComponent" parent="." index="2"]
script = ExtResource("4_animempty")

; 灰烬：DLC 没有灰烬动画，`CharredComponent` 换回基类（只把本体 reparent 出去），
; 被樱桃炸弹 / 火爆辣椒烧死时不至于去 `$ZombieCharred/CharredCorrect/AnimLib` 取空节点
[node name="CharredComponent" parent="." index="5"]
script = ExtResource("5_charred")

; 出土裁剪板：把整段动画裁在「地面以上」（Body 本地 y ≤ +10，即墓碑脚底那条线）——
; rise 里石碑从 y=78.8 升到 6.3，起始大半截在地面以下，不裁的话出土时会看到
; 石碑悬空滑上来（本体墓碑的出土就是 Panel clip_children 这么裁的，见 tombstone.tscn）。
; 墓土（Stone_dirt）在动画部件里本来就画在石碑**上面**（reanim 轨道序即层序），
; 正好盖住裁剪缝。
; ⚠️ Panel 挂在 Node2D 下时锚点不生效，矩形就是 offsets 那块（本体墓碑同一口径）。
; ⚠️ 矩形**要罩住受损动画崩出去的碎块**（2026-10-25 实测）：五段 break 里碎块最远飞到
;   Body 本地 x[-57.3, 77.3]、y[-117.5, 9.9]（Chunk / Layer / Bit 各自带缩放，按贴图尺寸量）；
;   板子原来只有 90×110（x[-45, 45]、y[-100, 10]），碎块一出界就被裁掉半截。
;   这里取 x[-80, 100]、y[-150, 10]：**只把「地面以下（y > 10）」裁掉**，左右上留够余量。
;   别把底边也往下放 —— 底边就是那条地面线，rise 靠它藏住地下半截。
;   ⚠️ 改这四条 offsets = 挪了动画的坐标系（动画节点是板的孩子），必须同步反补
;      `VSGravestoneAnim.position`（算法见文件头「站位」）。
[node name="VSGravestoneMask" type="Panel" parent="Body"]
clip_children = 2
offset_left = -80.0
offset_top = -150.0
offset_right = 100.0
offset_bottom = 10.0
mouse_filter = 2
material = SubResource("ShaderMaterial_mask")
theme_override_styles/panel = SubResource("StyleBoxFlat_mask")

[node name="VSGravestoneAnim" parent="Body/VSGravestoneMask" instance=ExtResource("3_anim")]
position = Vector2(40.5, 69.7)

; 动画场景里的 AnimLib 换成本地合成的七段库（idle / rise / break1~5，原因见文件头）
[node name="AnimLib" parent="Body/VSGravestoneMask/VSGravestoneAnim" index="91"]
