extends RefCounted
class_name ModIds
## 模组 id 常量表
##
## 本体与模组一律引用这里的常量，不写字面量字符串（写歪了不会报错，只会静默装不上）。
## 硬约束 §1-4：id → 脚本的映射只准出现在注册表里，这里的 id 与
## `ModManager.MOD_SCRIPT_PATHS` 一一对应。
##
## 新增一个模组的三步：
##   1. 本文件加一个常量
##   2. `ModManager.MOD_SCRIPT_PATHS` 加一行（id → 入口脚本路径）
##   3. `mods_builtin/<id>/` 下写入口脚本（继承 `ModBase`）与该模组自己的脚本 / 场景
## 开关：模组页面里开 / 关，存进 `user://<用户名>/mod_config.ini`（`ModManager` 统一管）；
## `data/mods/mod_config.tres` 只是**没有存档文件时播种用的工程默认**。

## 手套：把场上已种下的植物搬到另一个格子（不铲除、不重种，实例与状态全保留）
## 原版没有这个玩法（原版手套是禅境花园工具），所以整条链路都在模组里
const GLOVE := &"glove"

## 自制关卡：把 `user://custom_level` 下的玩家自制关卡脚本加载成可选关卡，
## 并在主菜单加一个入口按钮。原版没有这个功能，所以整条链路都在模组里
const CUSTOM_LEVEL := &"custom_level"

## 联机：多人（先做两人）合作共守一块草坪。原版没有任何联机功能，所以整条链路都在模组里。
## 当前是**骨架**：ENet 连线 + 玩家操作命令上行，还没做状态同步（见
## [联机模组](../../docs/参考存档/联机模组.md) §5 的阶段划分）
const NETPLAY := &"netplay"

## 更多的防具：铁桶之外再加三种矿石桶（铜桶 / 钻石桶 / 下界合金桶），
## 各配一只戴桶的僵尸。原版的桶只有铁桶一种，所以这三个盔甲连同它们的僵尸都在本模组里
const MORE_ARMOR := &"more_armor"

## 锤子：点一下草坪，对小范围内的僵尸造成伤害（伤害数值可调，也可一键秒杀）。
## 原版没有这个玩法（原版锤子只属于「锤僵尸」迷你游戏），所以整条链路都在模组里。
## 与迷你游戏的锤子（`src/items/mini_game/`、手持物类型 `Hammer`）互不相干
const HAMMER := &"hammer"

## 紫卡直接种植：紫卡（升级植物）不必先种基座植物，可以直接种在空地上，
## 代价是那一格多付「基座植物的阳光 + 50」。原版紫卡只能种在基座上，所以做成模组
const PURPLE_DIRECT_PLANT := &"purple_direct_plant"

## 水盆：新增一只**战斗植物** —— 花盆的水生形态（套用花盆场景里那条 `Pot_waterplants` 动画）。
## 跟花盆一样摆在草地 / 屋顶上，但盆里装的是水，**上面只接水生植物**（海蘑菇 / 缠绕海草），
## 于是草地上也能种海蘑菇 —— 原版没有这只植物、也没有这个组合，所以整件东西做成模组。
## 编号用本体留的槽位 `PlantIds.WATER_BOWL`，数据与卡片由模组运行期登记
const WATER_BOWL := &"water_bowl"

## 原版平衡：只**调整原版已有的数值**（当前是植物的阳光消耗与冷却时间，按「% 原版」缩放），
## 不加任何玩法。原版数值是多少就该是多少，所以这类同人调整做成模组 —— 关掉 = 回到原版数值
const BALANCE := &"balance"

## PVZ2：把《植物大战僵尸 2》的角色搬进本作（当前只有**菜问**）。
## 原版没有这些角色，美术也不是原版那套格式（PVZ2 是 PAM / XFL，不是 `.reanim`）——
## 所以整件东西做成模组：动画是离线烘焙好的 `.tscn`（贴图在 `res://mods_builtin/pvz2/bonkchoy/`，与脚本/场景同目录），
## 本仓库只收产物，不在运行时解析 PAM。
## 植物 id 自己起（`&"pvz2_bonkchoy"`），本体不必再留 `PlantIds` 空槽位
const PVZ2 := &"pvz2"

## 招笑版：只改**向日葵**与**豌豆射手**两只植物，两套都是原版没有的演出 —— 关掉 = 回到原版。
## 向日葵 → 「朝阳葵」：任何一株产阳光时其余朝阳葵一起转头看它（目标在左边就把花头镜像过去，
## 再旋转到「右侧对准目标」），它自己冒一颗汗（借禅境花园那颗「缺水」水珠贴图）。
## 豌豆射手 → 「傻豆射手」：普通攻击打出去的是一颗**不伤害人**的傻豆（两种随机：飞到僵尸跟前
## 掉地上 / 射偏），每打一颗攒怒气、怒气把整株染红，满了放大招 —— 怒气匀速降下去，
## 这段时间朝正前方 ±一定角度散射一堆**普通豌豆**
const ZHAOXIAO := &"zhaoxiao"
