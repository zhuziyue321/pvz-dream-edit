[gd_scene load_steps=9 format=3]

; 橡木弓箭手（DLC 的 Oak Archer）—— 战斗植物，由模组「DLC植物」提供
;
; 结构照 `../pultshroom/plant_pultshroom.tscn`（同一套 DLC 动画转换产物）：
; 本体 `plant_base.tscn` + 一个 DLC 动画节点 + 检测组件 + 攻击冷却 / 出箭计时器。
;
; 摆放（`Sprite2D` 全是 `centered = false`，`position` 是部件**左上角**，画布原点在左上）：
;   按 idle 第 0 帧的 `position` / `scale` / 贴图合并包围盒 ≈ x[-32.7, 111.9]、y[-43.0, 79.5]
;   （整株 ≈ 145×123 px，部件缩放 0.93；本体 1 格 = 76×95，橡木弓箭手比一格高一点）。
;   ⚠️ 有几个部件（arrow2 / arm_back / eyebrows）的贴图是**动画的 texture 轨道**在运行期塞进来的，
;      场景里没有 texture —— 静态合并会漏它们。**以运行期 `get_content_rect()` 为准**（探针里量），
;      下面这组 position / 底边是初值，跑完探针后按实际内容再校准。
;   对齐口径：让内容**底边**落在植物原点附近（贴地）；橡木弓箭手是棵橡树，比普通射手高，
;   取 position = -(底边中心) = (-39.6, -79.5)。
;   **不要给动画节点加缩放** —— 每部件的原版缩放已经在动画的 `scale` 轨道里，再叠一层就整株缩小。
;   `Marker2D` 放在持弓手（画布右侧）前方，箭从这里水平往右射出去。
;
; ⚠️ 为什么要覆盖 `AnimLib` 的库：转换工具把每段动画各放进一个独立 AnimationPlayer
;   （`Anim_OakArcher_idle` / `_shooting` …），而 `AnimLib` 里只有一条名叫 `ALL_ANIMS`
;   的合并动画 —— 那既不是分段名，也没法按段播。
;   这里把要用的几段 Animation 资源重新装进 `AnimLib` 的库，脚本只控制这一个播放器
;   （卡面取帧 `AnimationFrameUtil` 找的也正是它）。
;   `AnimLib` 在动画场景里是第 18 个直接子节点 → 覆盖时 `index="17"`（0 起）。

[ext_resource type="PackedScene" path="res://src/entities/character/plant/plant_base.tscn" id="1_base"]
[ext_resource type="PackedScene" path="res://mods_builtin/dlc/animation/character/plant/OakArcher/OakArcher.tscn" id="2_anim"]
[ext_resource type="Script" path="res://mods_builtin/dlc/oakarcher/oakarcher_plant.gd" id="3_script"]
[ext_resource type="Script" path="res://src/entities/character/components/detect_component/component_detect.gd" id="4_detect"]
[ext_resource type="Script" path="res://src/entities/character/components/anim_component/component_anim_empty.gd" id="5_animempty"]
[ext_resource type="Animation" path="res://mods_builtin/dlc/animation/character/plant/OakArcher/OakArcher_idle.tres" id="6_idle"]
[ext_resource type="Animation" path="res://mods_builtin/dlc/animation/character/plant/OakArcher/OakArcher_shooting.tres" id="7_shooting"]
[ext_resource type="Animation" path="res://mods_builtin/dlc/animation/character/plant/OakArcher/OakArcher_blink.tres" id="8_blink"]

; 三段动画合成一个库（挂到动画场景里那个 `AnimLib` 上）
[sub_resource type="AnimationLibrary" id="AnimationLibrary_oakarcher"]
_data = {
&"OakArcher_blink": ExtResource("8_blink"),
&"OakArcher_idle": ExtResource("6_idle"),
&"OakArcher_shooting": ExtResource("7_shooting")
}

; 本行射程：wiki 写「1x9」——9 格 = 76 × 9 = 684 px 往右铺，
; 覆盖一整行的僵尸（高度 60 只为兜住受击框，行过滤仍由 `DetectComponent.is_lane` 做）
[sub_resource type="RectangleShape2D" id="RectangleShape2D_oakarcher"]
size = Vector2(684, 60)

[node name="DlcOakArcher" node_paths=PackedStringArray("node2d_detect_in_slope") instance=ExtResource("1_base")]
script = ExtResource("3_script")
plant_type = &"dlc_oakarcher"
attack_value = 80
node2d_detect_in_slope = [NodePath("HurtBoxComponent/HurtBoxDetection"), NodePath("DetectComponent")]

[node name="AnimComponent" parent="." index="2"]
script = ExtResource("5_animempty")

[node name="OakArcherAnim" parent="Body" instance=ExtResource("2_anim")]
position = Vector2(-38, -57.5)

; 动画场景里的 `AnimLib` 换成本地合成的三段库（原因见文件头）
[node name="AnimLib" parent="Body/OakArcherAnim" index="17"]
libraries = {
&"": SubResource("AnimationLibrary_oakarcher")
}

[node name="Marker2D" type="Marker2D" parent="Body"]
position = Vector2(46.6, -25)

[node name="AttackCdTimer" type="Timer" parent="."]
wait_time = 4.25

[node name="ShootTimer" type="Timer" parent="."]
wait_time = 0.17
one_shot = true

[node name="DetectComponent" type="Node2D" parent="."]
script = ExtResource("4_detect")

[node name="Area2D" type="Area2D" parent="DetectComponent"]
position = Vector2(0, -25)
collision_layer = 0
collision_mask = 4

[node name="CollisionShape2D" type="CollisionShape2D" parent="DetectComponent/Area2D"]
position = Vector2(342, 0)
shape = SubResource("RectangleShape2D_oakarcher")
