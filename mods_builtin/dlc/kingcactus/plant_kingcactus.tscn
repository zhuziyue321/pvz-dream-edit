[gd_scene load_steps=13 format=3]

; 国王仙人掌（DLC 的 KingCactus）—— 战斗植物，由模组「DLC植物」提供
;
; 结构照 `../../pvz2/firepeashooter/plant_firepeashooter.tscn`：
; 本体 `plant_base.tscn` + 一个 DLC 动画节点 + 检测组件 + 攻击冷却 / 出刺计时器。
;
; 摆放：**不要给动画节点加缩放** —— 每个部件的原版缩放已经在动画的 `scale` 轨道里
;   （DLC 这部动画是 0.762，本体仙人掌是 0.8，同一量级），根节点再加一层就整株缩小了。
;   动画自己的画布原点在左上，含部件缩放后的包围盒 x[-1.5, 82.0]、y[-2.8, 84.4]（含天线与王冠），
;   整株 ≈ 84×87 px（格子 76×95，与本体仙人掌差不多）。
;   脚底中心 ≈ (40.3, 84.4)。`position = -(脚底中心) = (-40.3, -84.4)` 是「最低点正好落在植物原点」，
;   但实测本体仙人掌的内容底部在 Body 坐标 +6.9（植物整体比原点低一点才「贴地」），
;   而 DLC 这株没有根 / 花盆，只对齐最低点会显得**悬在格子上半部** —— 所以在
;   `-84.4` 的基础上先往下挪 10（-74.4），再按反馈继续下压 10：position = (-40.3, -64.4)。
;   现内容底部 ≈ Body 坐标 +19.9（本体仙人掌 +6.9），是要的「更贴地」效果。
;   `Marker2D` 放在身体中心（画布 (40.3, 40.4) → 节点坐标 (0, -24)）：
;   8 个方向的刺都从这一点出发，放在某一侧会让散射不对称。
;
; ⚠️ 为什么要覆盖 `AnimLib` 的库：转换工具把每段动画各放进一个独立 AnimationPlayer
;   （`Anim_KingCactus_idle` / `_shooting` / `_blink` / `_face`），而 `AnimLib` 里只有一条
;   名叫 `ALL_ANIMS` 的合并动画 —— 那既不是分段名，也没法按段播。
;   这里把四段 Animation 资源重新装进 `AnimLib` 的库，脚本只控制这一个播放器
;   （卡面取帧 `AnimationFrameUtil` 找的也正是它）。

[ext_resource type="PackedScene" path="res://src/entities/character/plant/plant_base.tscn" id="1_base"]
[ext_resource type="PackedScene" path="res://mods_builtin/dlc/animation/character/plant/KingCactus/KingCactus.tscn" id="2_anim"]
[ext_resource type="Script" path="res://mods_builtin/dlc/kingcactus/kingcactus_plant.gd" id="3_script"]
[ext_resource type="Script" path="res://src/entities/character/components/detect_component/component_detect.gd" id="4_detect"]
[ext_resource type="Script" path="res://src/entities/character/components/anim_component/component_anim_empty.gd" id="5_animempty"]
[ext_resource type="Animation" path="res://mods_builtin/dlc/animation/character/plant/KingCactus/KingCactus_idle.tres" id="6_idle"]
[ext_resource type="Animation" path="res://mods_builtin/dlc/animation/character/plant/KingCactus/KingCactus_shooting.tres" id="7_shooting"]
[ext_resource type="Animation" path="res://mods_builtin/dlc/animation/character/plant/KingCactus/KingCactus_blink.tres" id="8_blink"]
[ext_resource type="Animation" path="res://mods_builtin/dlc/animation/character/plant/KingCactus/KingCactus_face.tres" id="9_face"]

; 四段动画合成一个库（挂到动画场景里那个 `AnimLib` 上）
[sub_resource type="AnimationLibrary" id="AnimationLibrary_kingcactus"]
_data = {
&"KingCactus_blink": ExtResource("8_blink"),
&"KingCactus_face": ExtResource("9_face"),
&"KingCactus_idle": ExtResource("6_idle"),
&"KingCactus_shooting": ExtResource("7_shooting")
}

; **全屏**索敌框：视口 800×600、地图 9 列 × 5 行（约 684×475），
; 取 2400×1600 居中于植物 —— 植物种在屏幕任何一个角落都能罩住整块场地。
; 配合 `DetectComponent.is_lane = false`（不按行过滤），任何一行有僵尸就开火。
[sub_resource type="RectangleShape2D" id="RectangleShape2D_kingcactus"]
size = Vector2(2400, 1600)

[node name="DlcKingCactus" node_paths=PackedStringArray("node2d_detect_in_slope") instance=ExtResource("1_base")]
script = ExtResource("3_script")
plant_type = &"dlc_kingcactus"
attack_value = 20
node2d_detect_in_slope = [NodePath("HurtBoxComponent/HurtBoxDetection"), NodePath("DetectComponent")]

[node name="AnimComponent" parent="." index="2"]
script = ExtResource("5_animempty")

[node name="KingCactusAnim" parent="Body" instance=ExtResource("2_anim")]
position = Vector2(-38, -57.5)

; 动画场景里的 `AnimLib` 换成本地合成的四段库（原因见文件头）
[node name="AnimLib" parent="Body/KingCactusAnim" index="20"]
libraries = {
&"": SubResource("AnimationLibrary_kingcactus")
}

[node name="Marker2D" type="Marker2D" parent="Body"]
position = Vector2(2.3, -17.1)

[node name="SleepComponent" node_paths=PackedStringArray("sleep_influence_components") parent="." index="4"]
sleep_influence_components = [NodePath("../BlinkComponent"), NodePath("../DetectComponent")]

[node name="AttackCdTimer" type="Timer" parent="."]
wait_time = 1.6

[node name="ShootTimer" type="Timer" parent="."]
wait_time = 1.0
one_shot = true

[node name="DetectComponent" type="Node2D" parent="."]
script = ExtResource("4_detect")
is_lane = false

[node name="Area2D" type="Area2D" parent="DetectComponent"]
position = Vector2(0, -200)
collision_layer = 0
collision_mask = 4

[node name="CollisionShape2D" type="CollisionShape2D" parent="DetectComponent/Area2D"]
shape = SubResource("RectangleShape2D_kingcactus")
