[gd_scene load_steps=8 format=3 uid="uid://cdgu35wwga85t"]

; 国王仙人掌的尖刺 —— 继承本体 `bullet_cactus.tscn`（影子 / 攻击框都沿用），
; 换三样：
;   1. 脚本换成模组自己的弹道版本（见 kingcactus_spike.gd）：径向匀加速，速度方向按恒定角速度旋转；
;   2. 贴图换成 DLC 自己的 `kingcactus_spike.png`（20×20 朝右的细刺）—— 原来借的是本体
;      `ProjectileCactus.png`，能看但和本体仙人掌完全一样、看不出来自 DLC；
;   3. 命中特效：继承链上 `bullet_cactus.tscn` 写死了 `is_bullet_effect = false`，命中没有任何表现。
;      这里把 `BulletEffect` 换成 `bullet_effect_norm.gd`（基类那份只 reparent、不释放，会漏节点）
;      并打开开关，粒子用 `kingcactus_hit.png`（横向 3 帧、单帧 32×32 的小星形爆点）。
;
; 数值口径：
;   · speed = 50：**出手很慢**，先慢慢甩出去，之后靠径向加速度接管；
;   · radial_acceleration = 160：径向定值加速，1 秒 50 → 210；
;   · angular_speed = 0.9（弧度/秒 ≈ 51°/秒）：恒定转向，1 秒转 51°、2 秒转 102°；
;   · max_distance = 1400：8 个方向里朝下 / 朝后的会早早飞出画面，飞满 2000 没意义。

[ext_resource type="PackedScene" uid="uid://dewmob4swv03e" path="res://src/entities/bullet/bullet_cactus.tscn" id="1_base"]

[ext_resource type="Script" uid="uid://ci81vc10c2yvi" path="res://mods_builtin/dlc/kingcactus/kingcactus_spike.gd" id="2_script"]
[ext_resource type="Texture2D" path="res://mods_builtin/dlc/kingcactus/kingcactus_spike.png" id="3_spike"]
[ext_resource type="Script" path="res://src/fx/bullet_effect/bullet_effect_norm.gd" id="4_effect"]
[ext_resource type="Texture2D" path="res://mods_builtin/dlc/kingcactus/kingcactus_hit.png" id="5_hit"]

; 横向 3 帧的命中特效：`particles_animation` 让 GPUParticles2D 按贴图横向帧数逐帧播
[sub_resource type="CanvasItemMaterial" id="CanvasItemMaterial_hit"]
particles_animation = true
particles_anim_h_frames = 3
particles_anim_v_frames = 1
particles_anim_loop = false

; 命中点是固定的：不要初速度 / 重力，粒子就停在命中处把 3 帧播完
[sub_resource type="ParticleProcessMaterial" id="ParticleProcessMaterial_hit"]
direction = Vector3(0, 0, 0)
spread = 0.0
gravity = Vector3(0, 0, 0)
initial_velocity_min = 0.0
initial_velocity_max = 0.0

[node name="DlcKingCactusSpike" unique_id=433839121 instance=ExtResource("1_base")]
script = ExtResource("2_script")
bullet_type = &"dlc_kingcactus_spike"
speed = 50.0
radial_acceleration = 160.0
angular_speed = 0.9
max_distance = 1400.0

[node name="BulletBody" parent="Body" index="0"]
texture = ExtResource("3_spike")

[node name="BulletEffect" parent="." index="2"]
script = ExtResource("4_effect")
is_bullet_effect = true

[node name="GPUParticles2D" type="GPUParticles2D" parent="BulletEffect/AllParticles2D" index="0"]
material = SubResource("CanvasItemMaterial_hit")
emitting = false
amount = 1
texture = ExtResource("5_hit")
lifetime = 0.25
one_shot = true
explosiveness = 1.0
process_material = SubResource("ParticleProcessMaterial_hit")
