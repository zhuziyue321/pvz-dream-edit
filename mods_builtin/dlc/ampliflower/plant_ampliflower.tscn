[gd_scene load_steps=10 format=3]

; 增幅鹅河菊（DLC 的 Ampliflower）—— 范围增益植物，由模组「DLC植物」提供
;
; 结构照 `../bonkchoy/plant_bonkchoy.tscn`（同一套 DLC 动画转换产物）：
; 本体 `plant_base.tscn` + 一个 DLC 动画节点 + 光环扫描计时器 + 增幅演出计时器。
; **没有 `DetectComponent`** —— 增幅鹅河菊不索敌僵尸，枚举友方植物走
; `PlantCellManager.get_plant_cell_surrounding()`（脚本里按格子坐标取周围一圈）。
;
; 生命：`plant_base.tscn` 的 `HpComponent.max_hp` 默认就是 300，正好等于 wiki 值，不用改。
;
; 摆放（`Sprite2D` 全是 `centered = false`，`position` 是部件**左上角**，画布原点在左上）：
;   ⚠️ 不要给动画节点加缩放 —— 每部件的原版缩放已经在动画的 `scale` 轨道里，
;      根节点再加一层就整株缩小。
;   摆放已按探针 `get_content_rect()` 实测校准：整株内容底边对齐本体向日葵（同为花）。
;   实测（anim_root.position 未平移前）：增幅鹅河菊底边 +33.9、本体向日葵底边 +10.0，
;   故把 `position.y` 由 -50 抬高 23.8 到 -73.8（见 `test/scenarios/probe_dlc_ampliflower.gd` STEP5）。
;
; ⚠️ 为什么要覆盖 `AnimLib` 的库：转换工具把每段动画各放进一个独立 AnimationPlayer
;   （`Anim_Ampliflower_idle` / `_cheer` / `_blink` / `_face`），而 `AnimLib` 里只有一条
;   名叫 `ALL_ANIMS` 的合并动画 —— 那既不是分段名，也没法按段播。
;   这里把四段 Animation 资源重新装进 `AnimLib` 的库，脚本只控制这一个播放器
;   （卡面取帧 `AnimationFrameUtil` 找的也正是它）。
;   `AnimLib` 在动画场景里的索引 = 17（Ampliflower.tscn 中第 18 个子节点，0 基）。

[ext_resource type="PackedScene" path="res://src/entities/character/plant/plant_base.tscn" id="1_base"]
[ext_resource type="PackedScene" path="res://mods_builtin/dlc/animation/character/plant/Ampliflower/Ampliflower.tscn" id="2_anim"]
[ext_resource type="Script" path="res://mods_builtin/dlc/ampliflower/ampliflower_plant.gd" id="3_script"]
[ext_resource type="Script" path="res://src/entities/character/components/anim_component/component_anim_empty.gd" id="4_animempty"]
[ext_resource type="Animation" path="res://mods_builtin/dlc/animation/character/plant/Ampliflower/Ampliflower_idle.tres" id="5_idle"]
[ext_resource type="Animation" path="res://mods_builtin/dlc/animation/character/plant/Ampliflower/Ampliflower_cheer.tres" id="6_cheer"]
[ext_resource type="Animation" path="res://mods_builtin/dlc/animation/character/plant/Ampliflower/Ampliflower_blink.tres" id="7_blink"]
[ext_resource type="Animation" path="res://mods_builtin/dlc/animation/character/plant/Ampliflower/Ampliflower_face.tres" id="8_face"]

; 四段动画合成一个库（挂到动画场景里那个 `AnimLib` 上）
[sub_resource type="AnimationLibrary" id="AnimationLibrary_ampliflower"]
_data = {
&"Ampliflower_blink": ExtResource("7_blink"),
&"Ampliflower_cheer": ExtResource("6_cheer"),
&"Ampliflower_face": ExtResource("8_face"),
&"Ampliflower_idle": ExtResource("5_idle")
}

[node name="DlcAmpliflower" node_paths=PackedStringArray("node2d_detect_in_slope") instance=ExtResource("1_base")]
script = ExtResource("3_script")
plant_type = &"dlc_ampliflower"
node2d_detect_in_slope = [NodePath("HurtBoxComponent/HurtBoxDetection")]

[node name="AnimComponent" parent="." index="2"]
script = ExtResource("4_animempty")

[node name="AmpliflowerAnim" parent="Body" instance=ExtResource("2_anim")]
position = Vector2(-38, -57.5)

; 动画场景里的 `AnimLib` 换成本地合成的四段库（原因见文件头）
[node name="AnimLib" parent="Body/AmpliflowerAnim" index="17"]
libraries = {
&"": SubResource("AnimationLibrary_ampliflower")
}

[node name="BoostScanTimer" type="Timer" parent="."]
wait_time = 0.1

[node name="CheerTimer" type="Timer" parent="."]
wait_time = 5.0
