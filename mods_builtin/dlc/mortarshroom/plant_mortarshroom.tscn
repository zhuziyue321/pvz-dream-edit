[gd_scene load_steps=10 format=3]

; 臼炮蘑菇（DLC 的 Mortar-shroom）—— 战斗植物，由模组「DLC植物」提供
;
; 结构照 `../pultshroom/plant_pultshroom.tscn`（同一套 DLC 动画转换产物）：
; 本体 `plant_base.tscn` + 一个 DLC 动画节点 + 检测组件 + 攻击冷却 / 出弹计时器。
;
; 摆放（`Sprite2D` 全是 `centered = false`，`position` 是部件**左上角**，画布原点在左上）：
;   运行期用 `AnimationFrameUtil.get_content_rect(动画根)` 实测：整株 ≈ 78.7 × 71.3 px（画布中心约 (41,46)），
;   按「同为蘑菇、内容底边 / 水平中心对齐本体小喷菇」取 (-41.1, -81.4)
;   （实测底边差 ≈ 0.3 px、水平中心差 ≈ 0）。
;   **不要给动画节点加缩放** —— 每部件的原版缩放已经在动画的 `scale` 轨道里，再叠一层就整株缩小。
;   `Marker2D` 放在臼炮口（画布上方居中），炮弹从这里抛出去。
;
; ⚠️ 为什么要覆盖 `AnimLib` 的库：转换工具把每段动画各放进一个独立 AnimationPlayer
;   （`Anim_MortarShroom_idle` …），而 `AnimLib` 里只有一条叫 `ALL_ANIMS` 的合并动画 —— 那既不是
;   分段名，也没法按段播。这里把三段 Animation 资源重新装进 `AnimLib` 的库，脚本只控制这一个播放器
;   （卡面取帧 `AnimationFrameUtil` 找的也正是它）。

[ext_resource type="PackedScene" path="res://src/entities/character/plant/plant_base.tscn" id="1_base"]
[ext_resource type="PackedScene" path="res://mods_builtin/dlc/animation/character/plant/MortarShroom/MortarShroom.tscn" id="2_anim"]
[ext_resource type="Script" path="res://mods_builtin/dlc/mortarshroom/mortarshroom_plant.gd" id="3_script"]
[ext_resource type="Script" path="res://src/entities/character/components/detect_component/component_detect.gd" id="4_detect"]
[ext_resource type="Script" path="res://src/entities/character/components/anim_component/component_anim_empty.gd" id="5_animempty"]
[ext_resource type="Animation" path="res://mods_builtin/dlc/animation/character/plant/MortarShroom/MortarShroom_idle.tres" id="6_idle"]
[ext_resource type="Animation" path="res://mods_builtin/dlc/animation/character/plant/MortarShroom/MortarShroom_shooting.tres" id="7_shooting"]
[ext_resource type="Animation" path="res://mods_builtin/dlc/animation/character/plant/MortarShroom/MortarShroom_sleep.tres" id="8_sleep"]

; 三段动画合成一个库（挂到动画场景里那个 `AnimLib` 上）
[sub_resource type="AnimationLibrary" id="AnimationLibrary_mortarshroom"]
_data = {
&"MortarShroom_idle": ExtResource("6_idle"),
&"MortarShroom_shooting": ExtResource("7_shooting"),
&"MortarShroom_sleep": ExtResource("8_sleep")
}

; 抛射射程：wiki「Lobbed」—— 约 6 格 = 76 × 6 = 456 px 往右铺。
; ⚠️ **没有近身盲点**：早先按「Lobbed = 只轰远处」把左边缘设到 +114 px（1.5 格），
;    结果贴到脸上的僵尸进不了框、完全打不到 —— 这是对 wiki 的误读。
;    wiki 正文写的是「Changes target when the enemy is close」：敌人贴近时它**换目标继续打**，
;    不是打不到。所以左边缘要压回自己脚下、再往左留 20 px 兜住正在啃它的僵尸：
;    宽 480、中心 220 → 覆盖 -20 .. 460 px。
[sub_resource type="RectangleShape2D" id="RectangleShape2D_mortarshroom"]
size = Vector2(480, 60)

[node name="DlcMortarShroom" node_paths=PackedStringArray("node2d_detect_in_slope") instance=ExtResource("1_base")]
script = ExtResource("3_script")
plant_type = &"dlc_mortarshroom"
attack_value = 40
node2d_detect_in_slope = [NodePath("HurtBoxComponent/HurtBoxDetection"), NodePath("DetectComponent")]

[node name="AnimComponent" parent="." index="2"]
script = ExtResource("5_animempty")

[node name="MortarShroomAnim" parent="Body" instance=ExtResource("2_anim")]
position = Vector2(-38, -57.5)

; 动画场景里的 `AnimLib` 换成本地合成的三段库（原因见文件头）
[node name="AnimLib" parent="Body/MortarShroomAnim" index="9"]
libraries = {
&"": SubResource("AnimationLibrary_mortarshroom")
}

[node name="Marker2D" type="Marker2D" parent="Body"]
position = Vector2(0.1, -26.1)

; 蘑菇白天睡觉（wiki：Sleeps = Yes）—— 睡着的白天不索敌、不出弹；
; 姿势由脚本听 `SleepComponent` 的两个信号换成 `MortarShroom_sleep`
[node name="SleepComponent" node_paths=PackedStringArray("sleep_influence_components") parent="." index="4"]
sleep_influence_components = [NodePath("../BlinkComponent"), NodePath("../DetectComponent")]
is_sleep_in_day = true

[node name="AttackCdTimer" type="Timer" parent="."]
wait_time = 6.0

[node name="ShootTimer" type="Timer" parent="."]
wait_time = 0.45
one_shot = true

[node name="DetectComponent" type="Node2D" parent="."]
script = ExtResource("4_detect")

[node name="Area2D" type="Area2D" parent="DetectComponent"]
position = Vector2(0, -25)
collision_layer = 0
collision_mask = 4

[node name="CollisionShape2D" type="CollisionShape2D" parent="DetectComponent/Area2D"]
position = Vector2(220, 0)
shape = SubResource("RectangleShape2D_mortarshroom")
