[gd_scene load_steps=14 format=3]

; 电击蘑菇（DLC 的 VoltShroom）—— 战斗植物，由模组「DLC植物」提供
;
; 结构照 `../pultshroom/plant_pultshroom.tscn`（同一套 DLC 动画转换产物）：
; 本体 `plant_base.tscn` + 一个 DLC 动画节点 + 检测组件 + 攻击冷却计时器。
; 区别：这株是**周围放电 AOE**，不发射子弹 —— 没有 Marker2D / ShootTimer，
; 伤害在放电那一刻由脚本对检测范围内所有僵尸结算（DamageSystem.apply）。
;
; 摆放（`Sprite2D` 全是 `centered = false`，`position` 是部件**左上角**，画布原点在左上）：
;   ⚠️ 电击蘑菇有个「笼子」（cage / cageback）套在蘑菇外，整株比小喷菇大一圈；
;      具体包围盒以**运行期** `AnimationFrameUtil.get_content_rect()` 实测为准（探针里量），
;      这里先按蘑菇的量级给一个估计位置，探针跑完再对齐。
;   **不要给动画节点加缩放** —— 每部件的原版缩放已经在动画的 `scale` 轨道里，再叠一层就整株缩小。
;
; ⚠️ 为什么要覆盖 `AnimLib` 的库：转换工具把每段动画各放进一个独立 AnimationPlayer
;   （`Anim_VoltShroom_idle` …），而 `AnimLib` 里只有一条名叫合并动画（length 7.5s 的 `ALL_ANIMS`），
;   既不是分段名、也没法按段播。这里把要用的五段 Animation 资源重新装进 `AnimLib` 的库，
;   脚本只控制这一个播放器（卡面取帧 `AnimationFrameUtil` 找的也正是它）。
;   `index="22"` 是 `AnimLib` 在动画场景 `VoltShroom.tscn` 根节点子列表里的位置（实测数得）。

[ext_resource type="PackedScene" path="res://src/entities/character/plant/plant_base.tscn" id="1_base"]
[ext_resource type="PackedScene" path="res://mods_builtin/dlc/animation/character/plant/VoltShroom/VoltShroom.tscn" id="2_anim"]
[ext_resource type="Script" path="res://mods_builtin/dlc/voltshroom/voltshroom_plant.gd" id="3_script"]
[ext_resource type="Script" path="res://src/entities/character/components/detect_component/component_detect.gd" id="4_detect"]
[ext_resource type="Script" path="res://src/entities/character/components/anim_component/component_anim_empty.gd" id="5_animempty"]
[ext_resource type="Animation" path="res://mods_builtin/dlc/animation/character/plant/VoltShroom/VoltShroom_idle.tres" id="6_idle"]
[ext_resource type="Animation" path="res://mods_builtin/dlc/animation/character/plant/VoltShroom/VoltShroom_charge.tres" id="7_charge"]
[ext_resource type="Animation" path="res://mods_builtin/dlc/animation/character/plant/VoltShroom/VoltShroom_shooting.tres" id="8_shooting"]
[ext_resource type="Animation" path="res://mods_builtin/dlc/animation/character/plant/VoltShroom/VoltShroom_fin.tres" id="9_fin"]
[ext_resource type="Animation" path="res://mods_builtin/dlc/animation/character/plant/VoltShroom/VoltShroom_sleep.tres" id="10_sleep"]

; 五段动画合成一个库（挂到动画场景里那个 `AnimLib` 上）
[sub_resource type="AnimationLibrary" id="AnimationLibrary_voltshroom"]
_data = {
&"VoltShroom_idle": ExtResource("6_idle"),
&"VoltShroom_charge": ExtResource("7_charge"),
&"VoltShroom_shooting": ExtResource("8_shooting"),
&"VoltShroom_fin": ExtResource("9_fin"),
&"VoltShroom_sleep": ExtResource("10_sleep")
}

; 周围放电 AOE：wiki `range = 3x5` → **3 行 × 5 列**（行在前、列在后，同 `1x9` 那几条口径）。
; 本体 1 格 ≈ 76 px、一行 ≈ 85 px → 5 列 = 380 px、3 行 = 260 px。
; `is_lane = false`（跨行），所以形状以**植物根为基准居中**，y 略上移到植株中部。
[sub_resource type="RectangleShape2D" id="RectangleShape2D_voltshroom"]
size = Vector2(380, 260)

[node name="DlcVoltShroom" node_paths=PackedStringArray("node2d_detect_in_slope") instance=ExtResource("1_base")]
script = ExtResource("3_script")
plant_type = &"dlc_voltshroom"
attack_value = 53
node2d_detect_in_slope = [NodePath("HurtBoxComponent/HurtBoxDetection"), NodePath("DetectComponent")]

[node name="AnimComponent" parent="." index="2"]
script = ExtResource("5_animempty")

[node name="VoltShroomAnim" parent="Body" instance=ExtResource("2_anim")]
position = Vector2(-38, -57.5)

; 动画场景里的 `AnimLib` 换成本地合成的五段库（原因见文件头）
[node name="AnimLib" parent="Body/VoltShroomAnim" index="22"]
libraries = {
&"": SubResource("AnimationLibrary_voltshroom")
}

; 蘑菇白天睡觉（wiki：Sleeps = Yes）—— 睡着的白天不索敌、不放电；
; 姿势由脚本听 `SleepComponent` 的两个信号换成 `VoltShroom_sleep`
[node name="SleepComponent" node_paths=PackedStringArray("sleep_influence_components") parent="." index="4"]
sleep_influence_components = [NodePath("../BlinkComponent"), NodePath("../DetectComponent")]
is_sleep_in_day = true

[node name="AttackCdTimer" type="Timer" parent="."]
wait_time = 7.5

[node name="DetectComponent" type="Node2D" parent="."]
script = ExtResource("4_detect")
is_lane = false

[node name="Area2D" type="Area2D" parent="DetectComponent"]
position = Vector2(0, -30)
collision_layer = 0
collision_mask = 4

[node name="CollisionShape2D" type="CollisionShape2D" parent="DetectComponent/Area2D"]
position = Vector2(0, 0)
shape = SubResource("RectangleShape2D_voltshroom")
