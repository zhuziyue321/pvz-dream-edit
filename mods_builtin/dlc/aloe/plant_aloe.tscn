[gd_scene load_steps=12 format=3]

; 芦荟（DLC 的 AloeVera）—— 范围治疗植物，由模组「DLC植物」提供
;
; 结构照 `../bonkchoy/plant_bonkchoy.tscn`（同一套 DLC 动画转换产物）：
; 本体 `plant_base.tscn` + 一个 DLC 动画节点 + 治疗范围组件 + 治疗间隔计时器。
;
; 玩法（不攻击）：`HealAreaComponent` 的 Area2D 罩住宿主周围 3×3，
; 框里有受伤植物就每 3 秒治一次，每次每株 +30 血（见 `aloe_plant.gd`）。
;
; 摆放（`Sprite2D` 全是 `centered = false`，`position` 是部件**左上角**，画布原点在左上）：
;   按 idle 第 0 帧的 `position` / `scale` / PNG 尺寸合并包围盒 =
;   x[1.8, 80.4]、y[-15.5, 79.3]（整株 ≈ 78.6×94.8 px，部件缩放 0.9）。
;   脚底中心 ≈ (41.1, 79.3)：取 position = -(脚底中心)，再按「底边对齐本体向日葵」
;   的口径下压（探针量到向日葵 Body 内容底 = +10.0，所以这里让芦荟底也落在 +10）—— 定 (-41.1, -69.3)。
;   **不要给动画节点加缩放** —— 每部件的原版缩放已经在动画的 `scale` 轨道里，
;   根节点再加一层就整株缩小。
;
; ⚠️ 为什么要覆盖 `AnimLib` 的库：转换工具把每段动画各放进一个独立 AnimationPlayer
;   （`Anim_AloeVera_idle` / `_heal` / `_blink` / `_face`），而 `AnimLib` 里只有一条
;   名叫 `ALL_ANIMS` 的合并动画 —— 那既不是分段名，也没法按段播。
;   这里把四段 Animation 资源重新装进 `AnimLib` 的库，脚本只控制这一个播放器
;   （卡面取帧 `AnimationFrameUtil` 找的也正是它）。
;   `AnimLib` 在动画场景里的索引 = 13（AloeVera.tscn 中第 14 个子节点，0 基）。

[ext_resource type="PackedScene" path="res://src/entities/character/plant/plant_base.tscn" id="1_base"]
[ext_resource type="PackedScene" path="res://mods_builtin/dlc/animation/character/plant/AloeVera/AloeVera.tscn" id="2_anim"]
[ext_resource type="Script" path="res://mods_builtin/dlc/aloe/aloe_plant.gd" id="3_script"]
[ext_resource type="Script" path="res://mods_builtin/dlc/aloe/aloe_heal_area_component.gd" id="4_heal"]
[ext_resource type="Script" path="res://src/entities/character/components/anim_component/component_anim_empty.gd" id="5_animempty"]
[ext_resource type="Animation" path="res://mods_builtin/dlc/animation/character/plant/AloeVera/AloeVera_idle.tres" id="6_idle"]
[ext_resource type="Animation" path="res://mods_builtin/dlc/animation/character/plant/AloeVera/AloeVera_heal.tres" id="7_heal"]
[ext_resource type="Animation" path="res://mods_builtin/dlc/animation/character/plant/AloeVera/AloeVera_blink.tres" id="8_blink"]
[ext_resource type="Animation" path="res://mods_builtin/dlc/animation/character/plant/AloeVera/AloeVera_face.tres" id="9_face"]

; 四段动画合成一个库（挂到动画场景里那个 `AnimLib` 上）
[sub_resource type="AnimationLibrary" id="AnimationLibrary_aloe"]
_data = {
&"AloeVera_blink": ExtResource("8_blink"),
&"AloeVera_face": ExtResource("9_face"),
&"AloeVera_heal": ExtResource("7_heal"),
&"AloeVera_idle": ExtResource("6_idle")
}

; 治疗范围：3×3 格 —— 单元格 76×95（见 `plant_cell.tscn`），
; 228 × 285 罩住「上 / 同 / 下 三行 × 左 / 中 / 右 三列」。
; 中心 y = -27.5：植物原点在单元格底部上方 20 px（`PlantNormContainer`），
; 而 3×3 区域是以**单元格**为中心，不是以植物原点为中心。
[sub_resource type="RectangleShape2D" id="RectangleShape2D_aloe"]
size = Vector2(228, 285)

[node name="DlcAloe" node_paths=PackedStringArray("node2d_detect_in_slope") instance=ExtResource("1_base")]
script = ExtResource("3_script")
plant_type = &"dlc_aloe"
node2d_detect_in_slope = [NodePath("HurtBoxComponent/HurtBoxDetection")]

[node name="AnimComponent" parent="." index="2"]
script = ExtResource("5_animempty")

[node name="AloeVeraAnim" parent="Body" instance=ExtResource("2_anim")]
position = Vector2(-38, -57.5)

; 动画场景里的 `AnimLib` 换成本地合成的四段库（原因见文件头）
[node name="AnimLib" parent="Body/AloeVeraAnim" index="13"]
libraries = {
&"": SubResource("AnimationLibrary_aloe")
}

; 治疗间隔计时器：脚本按导出值 `heal_interval` 再设一次 `wait_time`
[node name="HealCdTimer" type="Timer" parent="."]
wait_time = 3.0
one_shot = true

; 治疗范围（3×3）：只监听「植物受击框检测层」layer 2，自身不占任何层
[node name="HealAreaComponent" type="Node2D" parent="."]
script = ExtResource("4_heal")

[node name="Area2D" type="Area2D" parent="HealAreaComponent"]
position = Vector2(0, -27.5)
collision_layer = 0
collision_mask = 2

[node name="CollisionShape2D" type="CollisionShape2D" parent="HealAreaComponent/Area2D"]
shape = SubResource("RectangleShape2D_aloe")
