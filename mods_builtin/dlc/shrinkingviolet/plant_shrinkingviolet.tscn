[gd_scene load_steps=8 format=3]

; 缩小紫罗兰（DLC 的 Shrinking Violet）—— 一次性控制植物，由模组「DLC植物」提供
;
; 结构照 `../pultshroom/plant_pultshroom.tscn`（同一套 DLC 动画转换产物）：
; 本体 `plant_base.tscn` + 一个 DLC 动画节点（两段：idle / bloom），**没有**检测框 /
; 攻击计时器 / 睡眠组件 —— 它是「种下即绽放、缩小全场僵尸、随后自身消失」的一次性植物，
; 不索敌、不睡觉（白天植物）。
;
; 摆放（`Sprite2D` 全是 `centered = false`，`position` 是部件**左上角**，画布原点在左上）：
;   动画自己的画布原点在左上，idle 段的整体部件缩放是 0.54。
;   ⚠️ 包围盒要以**运行期** `AnimationFrameUtil.get_content_rect()` 实测为准（探针里量），
;      不要只按静态部件手算 —— 有些部件的贴图是动画 `texture` 轨道在运行期塞进去的。
;   这里的 position 是**初估**，探针跑完按实测底边再校准；口径是「内容底边落在原点略下方」，
;   与本体同类花草一致（不要悬在格子上半部）。
;   **不要给动画节点加缩放** —— 每部件的原版缩放已经在动画的 `scale` 轨道里，再叠一层就整株缩小。
;
; ⚠️ 为什么要覆盖 `AnimLib` 的库：转换工具把每段动画各放进一个独立 AnimationPlayer
;   （`Anim_ShrinkingViolet_idle` / `_bloom` / `_idle_almanac`），而 `AnimLib` 里只有一条
;   名叫 `ALL_ANIMS` 的合并动画 —— 那既不是分段名，也没法按段播。
;   这里把要用的两段（idle / bloom）Animation 资源重新装进 `AnimLib` 的库，脚本只控制这一个播放器
;   （卡面取帧 `AnimationFrameUtil` 找的也正是它）。

[ext_resource type="PackedScene" path="res://src/entities/character/plant/plant_base.tscn" id="1_base"]
[ext_resource type="PackedScene" path="res://mods_builtin/dlc/animation/character/plant/ShrinkingViolet/ShrinkingViolet.tscn" id="2_anim"]
[ext_resource type="Script" path="res://mods_builtin/dlc/shrinkingviolet/shrinkingviolet_plant.gd" id="3_script"]
[ext_resource type="Script" path="res://src/entities/character/components/anim_component/component_anim_empty.gd" id="4_animempty"]
[ext_resource type="Animation" path="res://mods_builtin/dlc/animation/character/plant/ShrinkingViolet/ShrinkingViolet_idle.tres" id="5_idle"]
[ext_resource type="Animation" path="res://mods_builtin/dlc/animation/character/plant/ShrinkingViolet/ShrinkingViolet_bloom.tres" id="6_bloom"]

; 两段动画合成一个库（挂到动画场景里那个 `AnimLib` 上）
[sub_resource type="AnimationLibrary" id="AnimationLibrary_shrinkingviolet"]
_data = {
&"ShrinkingViolet_bloom": ExtResource("6_bloom"),
&"ShrinkingViolet_idle": ExtResource("5_idle")
}

[node name="DlcShrinkingViolet" instance=ExtResource("1_base")]
script = ExtResource("3_script")
plant_type = &"dlc_shrinkingviolet"

[node name="AnimComponent" parent="." index="2"]
script = ExtResource("4_animempty")

[node name="ShrinkingVioletAnim" parent="Body" instance=ExtResource("2_anim")]
position = Vector2(-38, -57.5)

; 动画场景里的 `AnimLib` 换成本地合成的两段库（原因见文件头；index=21 照转换产物的节点序）
[node name="AnimLib" parent="Body/ShrinkingVioletAnim" index="21"]
libraries = {
&"": SubResource("AnimationLibrary_shrinkingviolet")
}
