# Godot 4+ specific ignores
.godot/
/android/
.vscode

# 调试通道产生的日志（本地排查用，不要提交）
debug_channel_log.txt
debug_channel_auto_log.txt

# 会话里随手写的补丁/跑批临时脚本（清理时直接删）
.dsh_*
/_tmp_*.gd

# Godot 编译 reanim 的临时目录（编译产物，不入库）
assets/all_reanim/tmp/

# 无头跑批 / 泄漏检测留下的重定向输出（清理时直接删）
/_import_err.txt
/_import_out.txt
/_leak_err.txt
/_leak_out.txt

# autopilot 本地跑批留下的临时物（用户目录镜像、重定向输出、注入报告）
test/_userdir/
test/_ud_*/
test/_run_out.txt
test/_probe_version.txt
test/_semantic_scan_result.txt
test/inject/report.txt

# 第三方 addon 的编辑器状态：每次开编辑器都会自动改写（登记打开过的脚本列表），
# 与代码无关。注意它已在 git 里被跟踪过 —— 光加这一行不够，
# 还要 `git rm --cached addons/todo_controller/config/config.tres` 才生效。
addons/todo_controller/config/config.tres

# 参考用的独立子项目（PVZ2 动画/素材导入实验），自带 project.godot，
# 不属于本仓库 Godot 工程，不入库（3124 个文件，绝大部分是 .import / .png / .xml）
/新建游戏项目/

# agents
agents.state.json
.openagentpack/versions/
.env

# 根目录零散文案（2026-10-16 清理后加）：终端重定向产物 / npm 残留 / Godot 运行日志，一律不入库
# 前两条曾以「文件名含引号」的形态留在根目录，`git add -A` 会误提交，故按模式挡住
/*'*
/error_log.txt
/package.json
/package-lock.json
# 跑批遗留的临时脚本与其 .uid（.gd 那条见文件上方 /_tmp_*.gd）
/test/_tmp_*
